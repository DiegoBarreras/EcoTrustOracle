# ==============================================================================
# EcoTrust Oracle - Environment Configuration (.env.example)
# Copy this file to .env and populate your hackathon API credentials.
# Note: If credentials are left blank, Mock Fallback mode allows full end-to-end testing!
# ==============================================================================

# Server Configuration
APP_NAME="EcoTrust Oracle - B2B Physical Oracle"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ------------------------------------------------------------------------------
# 1. AI Vision (Developer 1): paste ONE key, the provider is detected from its prefix
#    Gemini   "AIza..." or "AQ...." https://aistudio.google.com/app/apikey
#    Claude   "sk-ant-..." https://platform.claude.com
#    DeepSeek "sk-..."     https://platform.deepseek.com
# ------------------------------------------------------------------------------
VISION_API_KEY=
# Optional: override the default vision model of the detected provider
VISION_MODEL=
# If true, returns a synthetic reading (flagged vision.is_mock) ONLY when no key is set.
# With a key, API failures always return an error: a fake reading is never anchored on Solana.
VISION_MOCK_FALLBACK=true

# ------------------------------------------------------------------------------
# 2. Web3 / Solana Blockchain: Solana Devnet & Memo Program (Developer 2)
# Public RPC: https://api.devnet.solana.com or QuickNode/Helius Devnet endpoints
# ------------------------------------------------------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com
# Base58 encoded secret key OR JSON array [1,2,3...]
# Generate with: solana-keygen new --outfile id.json
SOLANA_PRIVATE_KEY=
SOLANA_COMMITMENT=confirmed
# If true, simulates Devnet anchor signature if keypair has 0 SOL or RPC is busy
WEB3_MOCK_FALLBACK=true

# ------------------------------------------------------------------------------
# 3. Stakeholder Notifications: Telegram Bot API (Developer 3)
# Create a bot via @BotFather on Telegram: https://t.me/BotFather
# Find your Chat ID via @userinfobot: https://t.me/userinfobot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# One or more chat IDs, comma-separated (e.g. 111111111,222222222,333333333).
# Each person must send /start to the bot first.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# If true, prints notification to server console if Telegram credentials are missing
NOTIFIER_MOCK_FALLBACK=true
